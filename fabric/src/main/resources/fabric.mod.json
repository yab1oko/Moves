{
    "schemaVersion": 1,
    "id": "moves",
    "version": "${version}",
    "name": "${mod_name}",
    "description": "${description}",
    "authors": [
        "${mod_author}"
    ],
    "license": "${license}",
    "icon": "assets/moves/icon.png",
    "environment": "*",
    "entrypoints": {
        "main": [
            "yblk.moves.Moves"
        ],
        "client": [
            "yblk.moves.MovesClientMod"
        ],
        "modmenu": [
            "yblk.moves.client.MovesModMenu"
        ]
    },
    "mixins": [
        "${mod_id}.mixins.json",
        "${mod_id}.fabric.mixins.json"
    ],
    "depends": {
        "fabricloader": ">=0.14",
        "fabric": "*",
        "minecraft": "${minecraft_version}",
        "java": ">=17",
        "player-animator": "*"
    },
    "suggests": {
        "modmenu": "*"
    }
}
